# Copy to catalog-service/.local.env and run: uv run uvicorn app.main:create_app --factory --env-file .local.env
# Generate the local-dev key: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
CATALOG_API_KEYS=replace-with-local-dev-key
PUBLIC_BASE_URL=http://localhost:8000
RATE_LIMIT_PER_MINUTE=600
LOG_LEVEL=INFO
